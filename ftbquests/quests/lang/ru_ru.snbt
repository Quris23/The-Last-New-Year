	quest.5A1B00000000003B.quest_desc: ["Встретьте камнеката в карстовой пещере"]
	quest.5A1B00000000003B.title: "Катится, катится..."
	quest.5A1B00000000003C.quest_desc: ["Получите каменистый панцирь, сразив камнеката"]
	quest.5A1B00000000003C.title: "Камнепад!"
	quest.5A1B00000000003D.quest_desc: ["Изучите уникальных существ этого мира"]
	quest.5A1B00000000003D.title: "Alex's Mobs"
	quest.5A1B00000000003E.quest_desc: ["Спасите выброшенного на сушу кашалота, вытолкнув его в воду, получив в награду немного амбры"]
	quest.5A1B00000000003E.title: "Спаси кита!"
